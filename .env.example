# Public Google OAuth 2.0 Client ID (opsional jika menggunakan firebase-applet-config.json)
# Jangan pernah menyimpan OAuth Client Secret di frontend.
VITE_GOOGLE_CLIENT_ID=""

# Public Google API Key untuk kebutuhan Google Picker jika diperlukan di lingkungan eksternal
VITE_GOOGLE_API_KEY=""

# APP_URL: URL tempat aplikasi di-host
APP_URL="MY_APP_URL"

# Backend Security Gateway (Private Family Gallery — HANYA SERVER-SIDE, jangan gunakan prefix VITE_)
PORT=3001
GALLERY_ENCRYPTION_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
